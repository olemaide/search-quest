{
  "manifest_version": 3,
  "name": "SearchQuest – Lead Search Builder",
  "short_name": "SearchQuest",
  "version": "0.2.0",
  "description": "Build Google search-operator queries from blocks and templates, run search quests per city, save sites and pull their emails.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Open SearchQuest",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "side_panel": {
    "default_path": "app/panel.html"
  },
  "options_page": "app/app.html",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "sidePanel",
    "contextMenus"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.google.com/search*",
        "https://www.google.com/sorry/*",
        "https://www.google.de/search*",
        "https://www.google.de/sorry/*",
        "https://www.google.at/search*",
        "https://www.google.at/sorry/*",
        "https://www.google.ch/search*",
        "https://www.google.ch/sorry/*",
        "https://www.google.co.uk/search*",
        "https://www.google.co.uk/sorry/*",
        "https://www.google.ca/search*",
        "https://www.google.ca/sorry/*",
        "https://www.google.com.au/search*",
        "https://www.google.com.au/sorry/*",
        "https://www.google.ie/search*",
        "https://www.google.ie/sorry/*",
        "https://www.google.co.nz/search*",
        "https://www.google.co.nz/sorry/*",
        "https://www.google.fr/search*",
        "https://www.google.fr/sorry/*",
        "https://www.google.es/search*",
        "https://www.google.es/sorry/*",
        "https://www.google.it/search*",
        "https://www.google.it/sorry/*",
        "https://www.google.nl/search*",
        "https://www.google.nl/sorry/*",
        "https://www.google.be/search*",
        "https://www.google.be/sorry/*",
        "https://www.google.pl/search*",
        "https://www.google.pl/sorry/*"
      ],
      "js": [
        "content/google.js"
      ],
      "css": [
        "content/google.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
